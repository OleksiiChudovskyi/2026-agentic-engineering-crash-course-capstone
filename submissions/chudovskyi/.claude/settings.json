{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format --check *)",
      "Bash(python scripts/agent_log_summary.py *)",
      "Bash(python scripts/hooks_selftest.py)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv sync *)",
      "Bash(uv pip install *)",
      "Bash(pip install *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.dev*)",
      "Read(**/.env.prod*)",
      "Read(**/.env.agent*)",
      "Read(**/.env.local*)",
      "Read(./sets/**)",
      "Edit(**/.env)",
      "Edit(**/.env.dev*)",
      "Edit(**/.env.prod*)",
      "Edit(**/.env.agent*)",
      "Edit(**/.env.local*)",
      "Edit(./sets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_env.py"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log_action.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log_action.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/log_action.py"],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["context7"]
}
